########################################
# CN statepoint NVT production + RDF
# Generated by models/statepoint_eval/prepare_runs.py
#
# Protocol aligned with reference MD: timestep 1 fs (metal 0.001 ps), 6000 NVT steps.
# ChIMES requires units real (not metal); pair style remains chimesFF.
########################################

variable temp         equal {{TEMPERATURE_K}}
variable seed         equal {{SEED}}
variable delt         equal {{TIMESTEP_FS}}
variable md_steps     equal {{MD_STEPS}}
variable thermo_freq  equal {{THERMO_FREQ}}
variable dump_freq    equal {{DUMP_FREQ}}
variable nvt_tau      equal {{NVT_TAU_FS}}
variable rdf_bins     equal 200
variable rdf_rmax     equal 8.0

units           real
atom_style      atomic
boundary        p p p
atom_modify     sort 0 0.0
atom_modify     map array
newton          on

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes

read_data       data.in
velocity        all create ${temp} ${seed} loop all mom yes rot yes dist gaussian

pair_style      chimesFF fingerprint 0
pair_coeff      * * params.txt

timestep        ${delt}

thermo_style    custom step time ke pe temp press vol
thermo_modify   line one format float %20.5f flush yes
thermo          ${thermo_freq}

fix             nvt all nvt temp ${temp} ${temp} ${nvt_tau}

dump            1 all custom ${dump_freq} traj.lammpstrj id type element xu yu zu
dump_modify     1 sort id element C N

compute         rdf all rdf ${rdf_bins} 1 1 1 2 2 2 cutoff ${rdf_rmax}
fix             rdf_avg all ave/time {{RDF_NEVERY}} {{RDF_NREPEAT}} {{RDF_PERIODS}} c_rdf[*] file rdf.dat mode vector

run             ${md_steps}
